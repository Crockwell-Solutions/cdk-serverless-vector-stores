{
  "name": "cdk-serverless-vector-stores",
  "version": "0.1.0",
  "bin": {
    "cdk-serverless-vector-stores": "bin/app.ts"
  },
  "scripts": {
    "build": "tsc",
    "build:esbuild": "node_modules/.bin/esbuild --bundle src/**/*.ts --outbase=src/ --outdir=dist/ --sourcemap=inline --platform=node",
    "clean": "tsc --build --clean",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "synth": "cdk synth --all",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "frontend": "npm run dev --prefix frontend"
  },
  "devDependencies": {
    "@aws-lambda-powertools/logger": "^2.33.0",
    "@aws-sdk/client-dynamodb": "^3.1051.0",
    "@aws-sdk/lib-dynamodb": "^3.1051.0",
    "@aws-sdk/util-dynamodb": "^3.996.2",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^8.0.2",
    "@types/aws-lambda": "^8.10.161",
    "@types/jest": "^30.0.0",
    "@types/node": "25.9.1",
    "@typescript-eslint/parser": "^8.59.4",
    "aws-sdk-client-mock": "^4.1.0",
    "cdk-nag": "^2.38.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.10",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "dependencies": {
    "aws-cdk": "2.1124.1",
    "aws-cdk-lib": "^2.256.1",
    "constructs": "^10.6.0"
  }
}
