{
  "name": "cdk-serverless-vector-stores",
  "version": "1.0.0",
  "private": true,
  "description": "Reproducible vector-store comparisons and benchmarks for OpenSearch NextGen, S3 Vectors and DynamoDB",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run build && npm run lint && npm test && npm run synth",
    "cdk": "cdk",
    "synth": "cdk synth --quiet --context offline=true",
    "diff": "cdk diff",
    "deploy": "cdk deploy --outputs-file .vector-lab/outputs.json",
    "destroy": "cdk destroy",
    "lab": "node --import tsx src/cli.ts"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/client-bedrock": "3.1147.0",
    "@aws-sdk/client-bedrock-runtime": "3.1147.0",
    "@aws-sdk/client-cloudwatch": "3.1147.0",
    "@aws-sdk/client-dynamodb": "3.1147.0",
    "@aws-sdk/client-iam": "3.1147.0",
    "@aws-sdk/client-opensearchserverless": "3.1147.0",
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/client-s3vectors": "3.1147.0",
    "@aws-sdk/client-sts": "3.1147.0",
    "@aws-sdk/credential-providers": "3.1147.0",
    "@aws-sdk/util-dynamodb": "3.996.9",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/signature-v4": "5.7.4",
    "aws-cdk-lib": "2.272.0",
    "commander": "15.0.0",
    "constructs": "10.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "aws-cdk": "2.1145.0",
    "aws-sdk-client-mock": "4.1.0",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
