{
  "configurations": [
    {
      "type": "aws-sam",
      "request": "direct-invoke",
      "name": "Healthcheck Function",
      "preLaunchTask": "Build",
      "invokeTarget": {
        "target": "code",
        "architecture": "arm64",
        "projectRoot": "dist",
        "lambdaHandler": "api/healthcheck.handler"
      },
      "lambda": {
        "runtime": "nodejs22.x",
        "payload": {
          "json": {
            "event": "event"
          }
        }
      },
      "sam": {
        "localArguments": [
          "--container-env-vars",
          "${workspaceFolder}/local.env.json"
        ]
      }
    }
  ]
}